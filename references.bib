	doi = {10.1111/j.1467-8659.2006.00933.x},
	abstract = {Bounding volume hierarchies (BVHs) are a popular method for speeding up raytracing, but they can consume a large amount of memory for complex scenes. We investigate a hierarchical scheme for encoding BVHs that reduces the BVH storage requirements by 63\%–75\%. The computational overhead of the scheme can be reduced to negligible levels by shooting bundles of rays through the BVH (coherent raytracing). This gives the speed of a coherency-based raytracer combined with substantial memory savings.},
