	author = {Desbenoit, Brett and Galin, Eric and Akkouche, Samir},
	year = {2004},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1111/j.1467-8659.2004.00765.x},
	keywords = {ecosystem simulation, environment sensitive morphogenesis, lichen growth, plant modeling},
	pages = {341--350},
}

